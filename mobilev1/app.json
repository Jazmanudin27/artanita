{
  "expo": {
    "name": "Artanita Presensi Guru",
    "slug": "artanita-presensi-guru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2563eb",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.artanita.presensiguru",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi memerlukan lokasi GPS untuk presensi guru."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan foto selfie untuk bukti presensi."
        }
      ]
    ]
  }
}
